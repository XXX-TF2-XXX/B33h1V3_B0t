# ============================================================
# B33H1V3_B0T V2.4 CONFIGURATION  (copy this file to .env and fill in,
# or just use the app's Save Config button)
# Everything here works on FREE services: no paid plan is needed.
# ============================================================

# Jupiter API Key (OPTIONAL; blank uses Jupiter's free keyless tier).
# A free key from https://portal.jup.ag/ raises the rate limit.
JUPITER_API_KEY=

# Solana RPC Endpoint. A free Helius key works best:
#   https://mainnet.helius-rpc.com/?api-key=YOUR-FREE-HELIUS-KEY
# Any other RPC works too (e.g. https://solana-rpc.publicnode.com); the bot
# then prices fees with the standard getRecentPrioritizationFees method.
RPC_ENDPOINT=

# Main wallet private key (Base58). KEEP SECRET. Never share this file.
KEY=

# Target token mint address to trade
TOKEN_ADDRESS=

# ============================================================
# TRANSACTION SETTINGS
# ============================================================

# Buy amount range per trade (SOL)
MIN_BUY_AMOUNT=0.005
MAX_BUY_AMOUNT=0.008

# Max priority fee CAP per transaction (SOL). Fees are DYNAMIC: the bot pays
# the real-time rate for PRIORITY_LEVEL on the exact accounts it touches, never
# exceeding this cap, and escalates one level per retry if a tx expires.
PRIORITY_FEE=0.0005

# Starting priority level: low | medium | high | veryHigh  (low = cheapest;
# tested 2026-11-18: 58/58 transactions landed first try at low, ~1 s each)
PRIORITY_LEVEL=low

# RECYCLERS: how many fresh-wallet-per-trade workers run at once (0-10).
WALLET_CONCURRENCY=2

# Extra SOL sent to each trading wallet to cover fees + account rents. Fully
# swept back when the wallet is drained, so this only sets how much floats
# temporarily, not a cost. Raised automatically if too low.
SOL_TRANSFER_AMOUNT=0.01

# Max slippage tolerance in basis points (700 = 7%)
SLIPPAGE_BPS=700

# Delay between cycles, per worker (seconds)
DELAY=2

# ============================================================
# SPEED & LANDING
# ============================================================

# Swap engine: auto (direct PumpSwap when the token's pool exists, else
# Jupiter; switches by itself if the token graduates mid-session)
# | pumpswap | jupiter
SWAP_ENGINE=auto

# Helius Sender (free, no plan needed): off (plain RPC only: no tip, lowest
# fees) | swqos (staked fast path, 0.000005 SOL tip per tx) | max (all
# pathways incl. Jito, 0.001 SOL tip). Use swqos if the network is congested.
SENDER_MODE=off

# Sender region nearest this machine: auto | slc | ewr | lon | fra | ams | sg | tyo
SENDER_REGION=auto

# ============================================================
# VETERAN WALLETS
# ============================================================

# Veterans are funded once, trade several times with random waits, then are
# drained to zero and retired like every wallet. Each visit is a buy+sell, or
# a buy held until the next visit (VETERAN_HOLD_PCT chance), or the sell of
# what it held. 1-2 transactions per visit instead of a recycler's 4.
VETERAN_WALLETS=1
VETERAN_MIN_TRADES=3
VETERAN_MAX_TRADES=8
VETERAN_HOLD_PCT=50
VETERAN_WAIT_MIN=10
VETERAN_WAIT_MAX=60
